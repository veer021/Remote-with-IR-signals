<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121418">

    <!-- HEADER BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnHeaderBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_header_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Samsung TV"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnHeaderCast"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cast"
                android:padding="7dp"
                android:src="@drawable/ic_header_cast" />

            <ImageView
                android:id="@+id/btnHeaderExpand"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Expand"
                android:padding="7dp"
                android:src="@drawable/ic_header_expand" />

            <ImageView
                android:id="@+id/btnHeaderMore"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:padding="7dp"
                android:src="@drawable/ic_header_more_vert" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT SCROLLVIEW FOR FLEXIBILITY ON ALL SCREEN SIZES -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="28dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <!-- ROW 1 OF TOP CIRCULAR BUTTONS -->
            <!-- POWER BUTTON -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPower"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="33dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toStartOf="@id/cardSource"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnPower"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Power"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remote_power" />
            </com.google.android.material.card.MaterialCardView>

            <!-- INPUT / SOURCE BUTTON -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSource"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="33dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toStartOf="@id/cardMenu"
                app:layout_constraintStart_toEndOf="@id/cardPower"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnSource"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Input Source"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remote_input" />
            </com.google.android.material.card.MaterialCardView>

            <!-- MENU BUTTON -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenu"
                android:layout_width="66dp"
                android:layout_height="66dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="33dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardSource"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Menu"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remote_menu" />
            </com.google.android.material.card.MaterialCardView>


            <!-- ROW 2 OF TOP CIRCULAR BUTTONS -->
            <!-- HOME BUTTON -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHome"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="33dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toStartOf="@id/cardInfo"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPower">

                <ImageView
                    android:id="@+id/btnHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Home"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remote_home" />
            </com.google.android.material.card.MaterialCardView>

            <!-- INFO / NUMPAD BUTTON -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfo"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="33dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toStartOf="@id/cardReturn"
                app:layout_constraintStart_toEndOf="@id/cardHome"
                app:layout_constraintTop_toBottomOf="@id/cardSource">

                <ImageView
                    android:id="@+id/btnInfo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Info Numpad"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remote_info_one" />
            </com.google.android.material.card.MaterialCardView>

            <!-- RETURN / BACK BUTTON -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReturn"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="33dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cardInfo"
                app:layout_constraintTop_toBottomOf="@id/cardMenu">

                <ImageView
                    android:id="@+id/btnReturn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Return Back"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_remote_return" />
            </com.google.android.material.card.MaterialCardView>


            <!-- CENTER D-PAD AREA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDpadContainer"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_marginTop="36dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="125dp"
                app:cardElevation="3dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardHome">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- UP TOUCH AREA -->
                    <View
                        android:id="@+id/btnUp"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_dpad_up"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintBottom_toTopOf="@id/cardDpadOk"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- TOP DOT -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_dot_gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- DOWN TOUCH AREA -->
                    <View
                        android:id="@+id/btnDown"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_dpad_down"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cardDpadOk" />

                    <!-- BOTTOM DOT -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginBottom="32dp"
                        android:background="@drawable/bg_dot_gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- LEFT TOUCH AREA -->
                    <View
                        android:id="@+id/btnLeft"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_dpad_left"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cardDpadOk"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- LEFT DOT -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="32dp"
                        android:background="@drawable/bg_dot_gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- RIGHT TOUCH AREA -->
                    <View
                        android:id="@+id/btnRight"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_dpad_right"
                        android:clickable="true"
                        android:focusable="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cardDpadOk"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- RIGHT DOT -->
                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="32dp"
                        android:background="@drawable/bg_dot_gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- CENTER OK BUTTON -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDpadOk"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        app:cardBackgroundColor="#1A1C23"
                        app:cardCornerRadius="46dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#2C2F3A"
                        app:strokeWidth="1dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/btnOK"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dpad_center_ok"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="OK"
                            android:textColor="#F8FAFC"
                            android:textSize="16sp" />
                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- BOTTOM CONTROLS SECTION -->

            <!-- CHANNEL ROCKER (LEFT SIDE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChannelRocker"
                android:layout_width="72dp"
                android:layout_height="164dp"
                android:layout_marginTop="36dp"
                android:layout_marginStart="16dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="36dp"
                app:cardElevation="3dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardDpadContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- CHANNEL UP -->
                    <ImageView
                        android:id="@+id/btnChUp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_top_half"
                        android:contentDescription="Channel Up"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_up" />

                    <!-- CHANNEL TEXT -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="CH"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />

                    <!-- CHANNEL DOWN -->
                    <ImageView
                        android:id="@+id/btnChDown"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_bottom_half"
                        android:contentDescription="Channel Down"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_chevron_down" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SUB-BUTTON BELOW CHANNEL: MORE HORIZONTAL DOTS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardChSubButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="30dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="@id/cardChannelRocker"
                app:layout_constraintStart_toStartOf="@id/cardChannelRocker"
                app:layout_constraintTop_toBottomOf="@id/cardChannelRocker">

                <ImageView
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="More Options"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_more_horiz" />
            </com.google.android.material.card.MaterialCardView>


            <!-- VOLUME ROCKER (RIGHT SIDE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVolumeRocker"
                android:layout_width="72dp"
                android:layout_height="164dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="36dp"
                app:cardElevation="3dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardDpadContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- VOLUME UP -->
                    <ImageView
                        android:id="@+id/btnVolUp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_top_half"
                        android:contentDescription="Volume Up"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_plus" />

                    <!-- VOLUME TEXT -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="VOL"
                        android:textColor="#F8FAFC"
                        android:textSize="13sp" />

                    <!-- VOLUME DOWN -->
                    <ImageView
                        android:id="@+id/btnVolDown"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_bottom_half"
                        android:contentDescription="Volume Down"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_minus" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SUB-BUTTON BELOW VOLUME: MUTE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVolSubButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#22242B"
                app:cardCornerRadius="30dp"
                app:cardElevation="2dp"
                app:strokeColor="#2E323D"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="@id/cardVolumeRocker"
                app:layout_constraintStart_toStartOf="@id/cardVolumeRocker"
                app:layout_constraintTop_toBottomOf="@id/cardVolumeRocker">

                <ImageView
                    android:id="@+id/btnMute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_circle_button_white"
                    android:contentDescription="Mute"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_volume_off" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>